{
  "name": "biliardino-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node -e \"require('fs').mkdirSync('../client/dist',{recursive:true})\" && wrangler dev",
    "start": "npm run dev",
    "deploy": "npm --prefix ../client run build && wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "types": "wrangler types",
    "add-player": "node scripts/add-player.ts",
    "export-db": "node scripts/export-db.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.3"
  },
  "dependencies": {
    "hono": "^4.13.13"
  }
}
